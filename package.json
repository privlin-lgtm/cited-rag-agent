{
  "name": "cited-rag-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "corpus:fetch": "tsx scripts/corpus-fetch.ts",
    "ingest:corpus": "tsx --env-file-if-exists=.env.local scripts/ingest-corpus.ts",
    "smoke:sql": "tsx --env-file-if-exists=.env.local scripts/smoke-sql.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "5.0.3"
  }
}
